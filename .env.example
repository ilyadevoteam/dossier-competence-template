# Copier ce fichier en .env.local et y mettre ta vraie clé Gemini
# Obtenir une clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=copier_votre_cle_gemini_ici

# Optionnel — modèle Gemini par défaut (free tier : 500 RPD pour 3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optionnel — modèle de fallback si le primaire renvoie 503 (overload)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Optionnel — activer le Gemini context cache (économise des tokens)
GEMINI_CACHE=true
