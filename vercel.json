{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/chat.ts": {
      "runtime": "@vercel/node@3.2.0",
      "includeFiles": "api/corpus.md",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/chat",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
